MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_TOPIC=home/energy/ac

# Washer topics and independent SQLite files (relative to project root).
HEMS_MQTT_ROOT=home/hems
HEMS_DB=artifacts/hems.sqlite3
HEMS_DEVICE_DB=artifacts/washer.sqlite3

# Educational simulation parameters. Active tasks keep approved snapshots.
WASH_MINUTES=30
RINSE_MINUTES=15
SPIN_MINUTES=15
WASH_POWER_W=200
RINSE_POWER_W=100
SPIN_POWER_W=400
TARIFF_PEAK=6
TARIFF_OFFPEAK=2.5
AGENT_MAX_REQUESTS=15
AGENT_MAX_SECONDS=120
AGENT_REQUEST_SECONDS=20

# Azure resource HTTPS endpoint, API key, deployment name. Optional.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# vLLM base URL including /v1; model is the served model name.
# Key is optional when authentication is disabled on the server.
VLLM_BASE_URL=
VLLM_API_KEY=
VLLM_MODEL=
