MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_TOPIC=home/energy/ac

# Washer topics and independent SQLite files (relative to project root).
HEMS_MQTT_ROOT=home/hems
HEMS_DB=artifacts/hems.sqlite3
HEMS_DEVICE_DB=artifacts/washer.sqlite3

# Educational simulation parameters. Active tasks keep approved snapshots.
WASH_MINUTES=30
RINSE_MINUTES=15
SPIN_MINUTES=15
WASH_POWER_W=200
RINSE_POWER_W=100
SPIN_POWER_W=400
TARIFF_PEAK=6
TARIFF_OFFPEAK=2.5
AGENT_MAX_REQUESTS=15
AGENT_MAX_SECONDS=120
AGENT_REQUEST_SECONDS=20

# Primary: vLLM base URL including /v1; model is the served model name.
# Key is optional when authentication is disabled on the server.
VLLM_BASE_URL=
VLLM_API_KEY=
VLLM_MODEL=

# Fallback when vLLM is unavailable: Azure resource HTTPS endpoint,
# API key, deployment name. Optional.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# Phase 2: each device has its own unfinished task. Default is compatible MQTT.
HEMS_TRANSPORT=mqtt
HEMS_AC_DB=artifacts/ac.sqlite3
HEMS_BULB_DB=artifacts/bulb.sqlite3
# Matter controller and bridge share this storage location and pairing settings.
HEMS_MATTER_STORAGE=artifacts/matter
HEMS_MATTER_PORT=5540
HEMS_MATTER_DISCRIMINATOR=3840
HEMS_MATTER_PASSCODE=20202021
# Optional: error (default), info, debug
MATTER_LOG_LEVEL=error
